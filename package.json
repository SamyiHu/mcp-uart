{
  "name": "mcp-uart",
  "version": "1.5.0",
  "description": "Serial Port MCP Server for AI agents — structured tools, orchestrator_sequence orchestrator, Hub UI, profile-driven Orchestrator runner",
  "main": "bin/mcp-uart.mjs",
  "type": "module",
  "bin": {
    "mcp-uart": "bin/mcp-uart.mjs",
    "mcp-uart-hub": "bin/mcp-uart-hub.mjs",
    "serial-monitor": "bin/mcp-uart.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && node scripts/build-dsh-client.mjs",
    "build:dsh": "node scripts/build-dsh-client.mjs",
    "start": "node bin/mcp-uart.mjs",
    "hub": "node bin/mcp-uart-hub.mjs",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test:orchestrator": "node test/orchestrator-offline-test.mjs",
    "test:extract": "node test/extract-visualize-test.mjs",
    "test:hub": "node test/hub-api-test.mjs",
    "test:hub-orchestrator": "node test/hub-orchestrator-test.mjs",
    "test:sequence": "node test/sequence-test.mjs",
    "test:encoding": "node test/encoding-test.mjs",
    "test:framing": "node test/framing-test.mjs",
    "test:payload": "node test/payload-test.mjs",
    "test:history": "node test/history-test.mjs",
    "test:perf": "node test/perf-test.mjs",
    "test:dsh": "node test/dsh-client-test.mjs",
    "test": "npm run test:orchestrator && npm run test:extract && npm run test:hub && npm run test:hub-orchestrator && npm run test:sequence && npm run test:encoding && npm run test:framing && npm run test:payload && npm run test:history && npm run test:perf && npm run test:takeover && npm run test:dsh && npm run test:dsh-tools && npm run test:orchestrator-rust",
    "test:dsh-tools": "node test/dsh-agent-tools-test.mjs",
    "test:takeover": "node test/hub-takeover-test.mjs",
    "test:orchestrator-rust": "node test/orchestrator-rust-test.mjs",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "prebuild:rust": "node scripts/ensure-uartd.mjs > /dev/null"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bin",
    "scripts/ensure-uartd.mjs"
  ],
  "keywords": [
    "mcp",
    "serial",
    "uart",
    "serialport",
    "claude",
    "modbus",
    "embedded",
    "iot",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@serialport/parser-delimiter": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "iconv-lite": "^0.7.2",
    "serialport": "^13.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/uuid": "^10.0.0",
    "typescript": "^6.0.3"
  }
}
