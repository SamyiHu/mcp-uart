{
  "name": "mcp-uart",
  "version": "1.5.0",
  "description": "Serial Port MCP Server for AI agents — structured tools, dut_sequence orchestrator, Hub UI, profile-driven DUT runner",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-uart": "dist/index.js",
    "serial-monitor": "dist/monitor.js",
    "mcp-uart-hub": "dist/hub.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/dut/profiles','dist/dut/profiles',{recursive:true,filter:s=>!s.endsWith('.ts')});fs.cpSync('src/hub/public','dist/hub/public',{recursive:true})\" && node scripts/build-dsh-client.mjs",
    "build:dsh": "node scripts/build-dsh-client.mjs",
    "start": "node dist/index.js",
    "hub": "node dist/hub.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test:dut": "node test/dut-offline-test.mjs",
    "test:extract": "node test/extract-visualize-test.mjs",
    "test:hub": "node test/hub-api-test.mjs",
    "test:hub-dut": "node test/hub-dut-test.mjs",
    "test:sequence": "node test/sequence-test.mjs",
    "test:encoding": "node test/encoding-test.mjs",
    "test:framing": "node test/framing-test.mjs",
    "test:payload": "node test/payload-test.mjs",
    "test:history": "node test/history-test.mjs",
    "test:perf": "node test/perf-test.mjs",
    "test:dsh": "node test/dsh-client-test.mjs",
    "test": "npm run test:dut && npm run test:extract && npm run test:hub && npm run test:hub-dut && npm run test:sequence && npm run test:encoding && npm run test:framing && npm run test:payload && npm run test:history && npm run test:perf && npm run test:dsh && npm run test:dsh-tools",
    "test:dsh-tools": "node test/dsh-agent-tools-test.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "serial",
    "uart",
    "serialport",
    "claude",
    "modbus",
    "embedded",
    "iot",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@serialport/parser-delimiter": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "iconv-lite": "^0.7.2",
    "serialport": "^13.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/uuid": "^10.0.0",
    "typescript": "^6.0.3"
  }
}
