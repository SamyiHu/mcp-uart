{
  "name": "mcp-uart",
  "version": "1.2.0",
  "description": "Serial Port MCP Server for AI agents — structured output, precise extract/filters, HTML visualize, profile-driven DUT/FT runner (W6729 etc.)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-uart": "dist/index.js",
    "serial-monitor": "dist/monitor.js",
    "mcp-uart-hub": "dist/hub.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/dut/profiles','dist/dut/profiles',{recursive:true,filter:s=>!s.endsWith('.ts')});fs.cpSync('src/hub/public','dist/hub/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "hub": "node dist/hub.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test:dut": "node test/dut-offline-test.mjs",
    "test:extract": "node test/extract-visualize-test.mjs",
    "test:hub": "node test/hub-api-test.mjs",
    "test": "npm run test:dut && npm run test:extract && npm run test:hub"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "serial",
    "uart",
    "serialport",
    "claude",
    "modbus",
    "embedded",
    "iot",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@serialport/parser-delimiter": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "iconv-lite": "^0.7.2",
    "serialport": "^13.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/uuid": "^10.0.0",
    "typescript": "^6.0.3"
  }
}
