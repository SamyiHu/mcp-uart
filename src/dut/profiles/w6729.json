{
  "name": "w6729",
  "chip": "W6729 (FT test firmware, UART0 remap-A)",
  "description": "W6729 FT 固件测试协议：UART0@P2.0(TX)/P2.1(RX)，32MHz，727000bps 8N1。帧=3数据字节+校验(0xFF-累加和)。两段式握手（硬件实测确认）：发命令帧→DUT回显同帧→重发同一帧作握手→DUT回测试结果帧。判定值来自固件源码（instruction=00 00，CRC=55 55，OS短路=AC CA，SFR自检OK=0xCB）。注意：不可连续发送字节流，DUT回显期间到达的字节会overrun丢失。",
  "serial": {
    "baudRate": 727000,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "wiring": "USB串口适配器 TX→P2.1(DUT RX)，RX→P2.0(DUT TX)，共地。STOP/WDT/BTM唤醒由工具发break脉冲实现。USCI测试需P2.4/P2.5额外接线（见各命令note）。"
  },
  "frame": {
    "length": 4,
    "checksumIndex": 3,
    "checksum": "sum-complement"
  },
  "commands": [
    {
      "name": "freq_query",
      "title": "查询当前系统主频档位 (0x0F,04)",
      "actions": [
        {
          "type": "send-frame",
          "cmd": "0x0F",
          "p1": "0x04"
        },
        {
          "type": "expect-echo",
          "timeoutMs": 3000
        },
        {
          "type": "get-result",
          "timeoutMs": 2500
        }
      ],
      "judge": {
        "echoMatches": true,
        "resultEchoesCmd": true,
        "bytes": {
          "1": 0
        }
      },
      "note": "结果帧b1=主频档：0=32M，1=24M，2=20M，3=16M（b2为残留值不判）。也用作STOP/WDT唤醒后的存活探测。",
      "fpgaSuitable": true
    },
