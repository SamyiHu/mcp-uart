{
  "name": "w3652",
  "chip": "W3652 (manual tuning console, UART0 remap-B PA6/PA7)",
  "description": "W3652 手测固件文本控制台：UART0 重映射B(PA6/PA7)，115200bps 8N1。无成帧协议——profile 用 length=1 帧定义让全部 RX 文本落入 extras，判定用 extraContains 对 ASCII 串匹配。命令为单字节控制台命令：T=trim读回 D=ADC_DLY M=温度。",
  "serial": {
    "baudRate": 115200,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "wiring": "USB串口适配器 TX->PA7(DUT RX), RX->PA6(DUT TX), 共地。UART0 remap B。"
  },
  "frame": {
    "length": 1,
    "checksumIndex": 0,
    "checksum": "xor"
  },
  "commands": [
    {
      "name": "trim_readback",
      "title": "Trim读回 (T)：VBG/VREF/HRCR/LRC/HRCC/LDO + OP0/OP1",
      "actions": [
        {
          "type": "send-raw",
          "hex": "54",
          "note": "'T'"
        },
        {
          "type": "wait",
          "ms": 800
        },
        {
          "type": "expect-extra",
          "hex": "5452494D3A",
          "timeoutMs": 4000,
          "note": "'TRIM:'"
        }
      ],
      "judge": {
        "extraContains": "5452494D3A"
      },
      "note": "输出 TRIM: VBG/VREF/HRCR/HRCC/LRC/LDO/ADC_DLY/OP0/OP1 全部 trim 值。",
      "fpgaSuitable": true
    },
    {
      "name": "adc_dly_readback",
      "title": "OP_ADC_DLY 读回 (D)",
      "actions": [
        {
          "type": "send-raw",
          "hex": "44",
          "note": "'D'"
        },
        {
          "type": "wait",
          "ms": 500
        },
        {
          "type": "expect-extra",
          "hex": "4F505F4144435F444C59",
          "timeoutMs": 4000,
          "note": "'OP_ADC_DLY'"
        }
      ],
      "judge": {
        "extraContains": "4F505F4144435F444C59"
      },
      "note": "输出 OP_ADC_DLY=0xXX。",
      "fpgaSuitable": true
    },
    {
      "name": "ts_readback",
      "title": "温度传感器原始ADC (M)",
      "actions": [
        {
          "type": "send-raw",
          "hex": "4D",
          "note": "'M'"
        },
        {
          "type": "wait",
          "ms": 500
        },
        {
          "type": "expect-extra",
          "hex": "545320726177",
          "timeoutMs": 5000,
          "note": "'TS raw'"
        }
      ],
      "judge": {
        "extraContains": "545320726177"
      },
      "note": "输出 TS raw=XXXX（2.4V参考）。",
      "fpgaSuitable": true
    }
  ],
  "smoke": [
    "trim_readback",
    "adc_dly_readback",
    "ts_readback"
  ]
}