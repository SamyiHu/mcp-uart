{
  "name": "@local/dsh-uart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serial panel + DSH-native agent tools for DeepSeek Harness: one bundle owns the local Hub, the panel/orb/dock console, and three grouped UART tools (uart_serial / uart_dut / uart_view).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./tools/*": "./tools/*"
  },
  "files": [
    "index.js",
    "hub-host.js",
    "client.js",
    "cordis.patch.yml",
    "DESIGN-floating-bubble.md",
    "DESIGN-dual-mode-tools.md",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
